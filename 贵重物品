local CONFIG = {
    SERVER_FETCH_RETRY_DELAY = 0.1,
    TELEPORT_COOLDOWN = 0.1,
    FORBIDDEN_ZONE = {
        center = Vector3.new(352.884155, 13.0287256, -1353.05396),
        radius = 80
    },
}
local visitedServers = {}

local function getHumanoidRootPart()
    local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
    return character:FindFirstChild("HumanoidRootPart")
end

local function teleportTo(position)
    local hrp = getHumanoidRootPart()
    if hrp and position then
        hrp.CFrame = CFrame.new(position + Vector3.new(0, 3, 0))
        task.wait(0.1)
    end
end

local function scanForTargets()
    local found = {}
    local targets = {
        "Money Printer", "Military Armory Keycard", "Suitcase Nuke", "Nuke Launcher", "Easter Basket",
        "Bunny Balloon", "Ghost Balloon", "Clover Balloon", "Bat Balloon", "Gold Clover Balloon",
        "Golden Rose", "Black Rose", "Heart Balloon", "Blue Candy Cane", "NextBot Grenade",
        "Void Gem", "Treasure Map", "Dark Matter Gem", "Diamond", "Diamond Ring", "Requirements"
    }
    
    for _, item in ipairs(Workspace:GetDescendants()) do
        if item:IsA("ProximityPrompt") then
            local objectText = item.ObjectText
            for _, target in ipairs(targets) do
                if objectText == target then
                    local parent = item:FindFirstAncestorWhichIsA("BasePart")
                    if parent then
                        local dist = (parent.Position - CONFIG.FORBIDDEN_ZONE.center).Magnitude
                        if dist > CONFIG.FORBIDDEN_ZONE.radius then
                            table.insert(found, {part = parent, prompt = item})
                        end
                    end
                    break
                end
            end
        end
    end
    return found
end

local function fetchServerList()
    local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", game.PlaceId)
    local req = syn and syn.request or http_request or http and http.request or fluxus and fluxus.request or request or function(u, o) return {StatusCode = 404} end
    local success, response = pcall(req, {Url = url, Method = "GET", Timeout = 10})
    if not success or not response or response.StatusCode ~= 200 then return nil end
    local success2, data = pcall(HttpService.JSONDecode, HttpService, response.Body)
    if not success2 or not data or not data.data then return nil end
    local filtered, currentJobId = {}, game.JobId
    for _, server in ipairs(data.data) do
        if server.playing < server.maxPlayers and server.id ~= currentJobId and not visitedServers[server.id] then
            table.insert(filtered, server)
        end
    end
    return filtered
end

local startTime = tick()

local function mainLoop()
    while true do
        local currentTime = tick()
        
        if currentTime - startTime >= 3 then
            print("运行已达3秒，强制切换服务器。")
            local fetchedServers = fetchServerList()
            if fetchedServers and #fetchedServers > 0 then
                visitedServers[fetchedServers[1].id] = true
                TeleportService:TeleportToPlaceInstance(game.PlaceId, fetchedServers[1].id, localPlayer)
                task.wait(CONFIG.TELEPORT_COOLDOWN)
                
                VirtualInputManager:SendKeyEvent(true, "E", false, game)
                task.wait(0.1)
                VirtualInputManager:SendKeyEvent(false, "E", false, game)
            else
                task.wait(CONFIG.SERVER_FETCH_RETRY_DELAY)
            end
        else
            local root = getHumanoidRootPart()
            local targets = scanForTargets()
            
            if #targets > 0 then
                for _, target in ipairs(targets) do
                    if target.part and target.prompt and root then
                        teleportTo(target.part.Position)
                        VirtualInputManager:SendKeyEvent(true, "E", false, game)
                        task.wait(0.1)
                        VirtualInputManager:SendKeyEvent(false, "E", false, game)
                        task.wait(0.1)
                    end
                end
            else
                task.wait(0.1)
            end
        end
        task.wait(0.1)
    end
end

mainLoop()